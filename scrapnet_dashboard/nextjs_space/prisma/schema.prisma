  // Compliance
  complianceStatus      String            @default("PENDING") @map("compliance_status")
  geniusActCompliant    Boolean           @default(false) @map("genius_act_compliant")
  poeVerificationHash   String?           @map("poe_verification_hash")
  
  // Retro-settlement status
  settledAt             DateTime?         @map("settled_at")
  settlementHash        String?           @map("settlement_hash")
  pulseStringGenerated  String?           @map("pulse_string_generated") @db.Text
  
  // Ledger link
  ledgerEntryId         String?           @map("ledger_entry_id")
  
  @@index([ownerId])
  @@index([dataSource])
  @@index([periodFrom])
  @@index([complianceStatus])
  @@index([createdAt])
  @@map("legacy_audits")
}

