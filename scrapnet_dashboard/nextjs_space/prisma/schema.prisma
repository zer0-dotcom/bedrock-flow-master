generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ==================== USER & AUTH MODELS ====================

enum UserRole {
  ADMIN
  AGENT
  FARMER
  REALTOR
  BUSINESS_OWNER
  SOVEREIGN_INDIVIDUAL
  FOUNDER
  SOVEREIGN_AGENT
  CLIENT_OWNER
}

enum AgentStatus {
  REVIEW_REQUIRED
  APPROVED
  SUSPENDED
}

enum ServiceType {
  ASPHALT
  BIOCHAR
  METAL
}

enum LocationType {
  RECYCLING_CENTER    // Asphalt recycling yards
  BIOCHAR_FACILITY    // Biochar processing plants
  HYBRID              // Combined operations
}

model User {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Identification - support both email and username
  email           String?   @unique
  username        String?   @unique
  passwordHash    String    @map("password_hash")
  
  // Profile
  name            String
  phone           String?
  
  // Role & Verification
  role            UserRole  @default(FARMER)
  isVerified      Boolean   @default(false) @map("is_verified")
  verifiedAt      DateTime? @map("verified_at")
  
  // Onboarding status
  onboardingComplete Boolean @default(false) @map("onboarding_complete")
  
  // Enabled services for this user (Circular Trifecta)
  services        ServiceType[] @default([ASPHALT, BIOCHAR])
  
  // Agent-specific status
  agentStatus     AgentStatus? @map("agent_status")
  agentStatusUpdatedAt DateTime? @map("agent_status_updated_at")
  
  // Invitation code used for signup (agents)
  invitationCodeId String?  @map("invitation_code_id")
  invitationCode   InvitationCode? @relation(fields: [invitationCodeId], references: [id])
  
  // For FARMER role - assigned location (recycling yard or biochar facility)
  locationId      String?   @map("location_id")
  location        Location? @relation(fields: [locationId], references: [id])
  
  // For linking to existing Farmer record (optional)
  farmerId        String?   @unique @map("farmer_id")
  farmer          Farmer?   @relation(fields: [farmerId], references: [id])
  
  // Role-specific profiles (one of these based on role)
  farmerProfile   FarmerProfile?
  realtorProfile  RealtorProfile?
  businessProfile BusinessProfile?
  sovereignProfile SovereignProfile?
  
  // User's carbon calculator entries
  carbonEntries   UserCarbonEntry[]
  
  // User's legacy audits
  legacyAuditsOwned LegacyAudit[] @relation("LegacyAuditOwner")
  
  // Recycling logs submitted by this user
  recyclingLogs   RecyclingLog[]

  @@map("users")
}

model InvitationCode {
  id              String   @id @default(uuid())
  code            String   @unique
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime? @map("expires_at")
  
  // Usage limits
  maxUses         Int      @default(1) @map("max_uses")
  usedCount       Int      @default(0) @map("used_count")
  
  // Metadata
  createdBy       String?  @map("created_by")
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  
  // Users who used this code
  users           User[]

  @@map("invitation_codes")
}

// ==================== ROLE-SPECIFIC PROFILE MODELS ====================

enum LandType {
  CROPLAND
  PASTURE
  FOREST
  WETLAND
  MIXED
  OTHER
}

model FarmerProfile {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // User reference
  userId          String    @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Farmer-specific fields
  landType        LandType  @default(CROPLAND) @map("land_type")
  acreage         Float     @default(0)
  historicalYieldJson String? @map("historical_yield_json") @db.Text // JSON: yearly yield data
  
  // Additional details
  farmName        String?   @map("farm_name")
  farmLocation    String?   @map("farm_location")
  primaryCrop     String?   @map("primary_crop")
  certifications  String?   @db.Text // JSON array: organic, regenerative, etc.
  
  @@map("farmer_profiles")
}

model RealtorProfile {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // User reference
  userId          String    @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Realtor-specific fields
  propertyListingCount Int   @default(0) @map("property_listing_count")
  avgEfficiencyRating Float  @default(0) @map("avg_efficiency_rating") // 1-100 scale
  
  // Additional details
  licenseNumber   String?   @map("license_number")
  brokerage       String?
  marketRegion    String?   @map("market_region")
  specializations String?   @db.Text // JSON array: commercial, residential, green, etc.
  avgListingPrice Float?    @map("avg_listing_price")
  
  @@map("realtor_profiles")
}

model BusinessProfile {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // User reference
  userId          String    @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Business-specific fields (Scope 1/2/3 emissions)
  scope1Emissions Float     @default(0) @map("scope1_emissions") // Direct emissions (tonnes CO2/year)
  scope2Emissions Float     @default(0) @map("scope2_emissions") // Indirect energy (tonnes CO2/year)
  scope3Emissions Float     @default(0) @map("scope3_emissions") // Value chain (tonnes CO2/year)
  
  // Additional details
  companyName     String?   @map("company_name")
  industry        String?
  employeeCount   Int?      @map("employee_count")
  annualRevenue   Float?    @map("annual_revenue")
  fiscalYear      Int?      @map("fiscal_year")
  reportingStandard String? @map("reporting_standard") // GHG Protocol, CDP, etc.
  
  @@map("business_profiles")
}

model SovereignProfile {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // User reference
  userId          String    @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Sovereign Individual fields
  zipCode         String?   @map("zip_code")
  householdSize   Int       @default(1) @map("household_size")
  
  // Vibrational metrics (calculated from Legacy Healer)
  vibrationalBalance Float  @default(0) @map("vibrational_balance") // Total carbon equity USD
  ledgerEquity       Float  @default(0) @map("ledger_equity") // 70% founder yield
  historicalAuditsCount Int @default(0) @map("historical_audits_count")
  
  // Consciousness level
  consciousnessLevel Int    @default(1) @map("consciousness_level")
  sovereignScore     Int    @default(0) @map("sovereign_score")
  
  // Property telemetry fields (v2.4 onboarding patch)
  annualFootprint   Float?   @map("annual_footprint")   // Annual utility baseline kWh
  offsetGoal        Float?   @map("offset_goal")        // 70% Sovereign Share capacity USD

  // Pentagon data cache
  pentagonDataJson  String?  @map("pentagon_data_json") @db.Text
  
  @@map("sovereign_profiles")
}

// ==================== USER CARBON ENTRIES ====================

model UserCarbonEntry {
  id              String    @id @default(uuid())
  entryId         String    @unique @map("entry_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // User reference
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Entry type
  entryType       String    @map("entry_type") // ASPHALT, BIOCHAR, LEGACY_HEALER, RE_HOSPITALITY
  
  // Carbon metrics
  carbonSavedTonnes Float   @map("carbon_saved_tonnes")
  carbonValueUsd    Float   @map("carbon_value_usd")
  
  // Universal Law split
  founderYield70    Float   @map("founder_yield_70")
  stewardship20     Float   @map("stewardship_20")
  publicOverflow10  Float   @map("public_overflow_10")
  
  // Source reference (links to original record)
  sourceTable       String  @map("source_table")
  sourceId          String  @map("source_id")
  
  // Verification
  poeHash           String? @map("poe_hash")
  verified          Boolean @default(false)
  
  @@index([userId])
  @@index([entryType])
  @@index([createdAt])
  @@map("user_carbon_entries")
}

// ==================== UNIFIED LOCATION MODEL ====================
// Replaces separate Yard and BiocharSite models

model Location {
  id              String       @id @default(uuid())
  locationId      String       @unique @map("location_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  
  // Location details
  name            String
  type            LocationType @default(RECYCLING_CENTER)
  address         String?
  gpsCoordinates  String?      @map("gps_coordinates")
  
  // Operational details
  isActive        Boolean      @default(true) @map("is_active")
  capacity        Float?       // Processing capacity in tonnes/day
  certifications  String?      @db.Text  // JSON array of certifications
  
  // Contact info
  contactName     String?      @map("contact_name")
  contactPhone    String?      @map("contact_phone")
  contactEmail    String?      @map("contact_email")
  
  // Users assigned to this location
  users           User[]
  
  // Recycling logs destined for this location (RECYCLING_CENTER, HYBRID)
  recyclingLogs   RecyclingLog[]
  
  // Biochar batches processed at this location (BIOCHAR_FACILITY, HYBRID)
  biocharBatches  BiocharBatch[]

  @@index([type])
  @@index([isActive])
  @@map("locations")
}

model Project {
  id                    String   @id @default(uuid())
  projectId             String   @unique @map("project_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  // Input parameters
  plannedTonnage        Float    @map("planned_tonnage")
  targetRapPercentage   Float    @map("target_rap_percentage")
  tripDistance          Float    @map("trip_distance")
  mixType               String   @map("mix_type")
  layerType             String   @map("layer_type")
  carbonCap             Float    @default(60) @map("carbon_cap")
  
  // Output results
  predictedCo2Emissions Float    @map("predicted_co2_emissions")
  optimalRapPercentage  Float    @map("optimal_rap_percentage")
  carbonScore           Float    @map("carbon_score")
  tonsCo2Saved          Float    @map("tons_co2_saved")
  mixRecommendation     String   @map("mix_recommendation") @db.Text
  meetsGreenTarget      Boolean  @map("meets_green_target")
  carbonCapCompliance   Boolean  @map("carbon_cap_compliance")
  
  // Blockchain metadata
  gpsCoordinates        String?  @map("gps_coordinates")
  blockchainTimestamp   DateTime @map("blockchain_timestamp")
  blockchainJson        String   @map("blockchain_json") @db.Text

  @@map("projects")
}

// ==================== BIOCHAR ENGINE MODELS ====================

model Farmer {
  id              String   @id @default(uuid())
  farmerId        String   @unique @map("farmer_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  // Farmer details
  name            String
  email           String?
  phone           String?
  farmName        String?  @map("farm_name")
  farmLocation    String?  @map("farm_location")
  gpsCoordinates  String?  @map("gps_coordinates")
  
  // Verification status
  isVerified      Boolean  @default(false) @map("is_verified")
  verifiedAt      DateTime? @map("verified_at")
  
  // Agent/Referrer relationship
  referrerId      String?  @map("referrer_id")
  referrer        Farmer?  @relation("FarmerReferrals", fields: [referrerId], references: [id])
  referrals       Farmer[] @relation("FarmerReferrals")
  
  // Aggregated stats
  totalFeedstockKg    Float   @default(0) @map("total_feedstock_kg")
  totalCreditsEarned  Float   @default(0) @map("total_credits_earned")
  totalAgentCommission Float  @default(0) @map("total_agent_commission")
  
  // Relations
  biocharBatches  BiocharBatch[]
  credits         FarmerCredit[]
  user            User?

  @@map("farmers")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model BiocharBatch {
  id                    String   @id @default(uuid())
  batchId               String   @unique @map("batch_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  // Verification status (for agent approval)
  verificationStatus    VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt            DateTime? @map("verified_at")
  verifiedBy            String?   @map("verified_by")
  rejectionReason       String?   @map("rejection_reason")
  
  // Input parameters
  feedstockType         String   @map("feedstock_type")
  dryWeightKg           Float    @map("dry_weight_kg")
  moistureContentPercent Float   @default(15) @map("moisture_content_percent")
  pyrolysisTempCelsius  Float    @map("pyrolysis_temp_celsius")
  hCorgRatio            Float    @map("h_corg_ratio")
  
  effectiveDryWeightKg  Float    @map("effective_dry_weight_kg")
  biocharYieldKg        Float    @map("biochar_yield_kg")
  cdrCreditsTonnes      Float    @map("cdr_credits_tonnes")
  co2EquivalentTonnes   Float    @map("co2_equivalent_tonnes")
  
  // Stability & Permanence
  stabilityClass        String   @map("stability_class")
  permanenceYears       Int      @map("permanence_years")
  permanenceFactor      Float    @map("permanence_factor")
  
  // Process compliance
  processCompliant      Boolean  @map("process_compliant")
  warnings              String?  @db.Text
  
  // Location & Traceability
  feedstockSourceGps    String?  @map("feedstock_source_gps")
  processingLocationId  String?  @map("processing_location_id")
  processingLocation    Location? @relation(fields: [processingLocationId], references: [id])
  
  // Farmer relation (optional)
  farmerId              String?  @map("farmer_id")
  farmer                Farmer?  @relation(fields: [farmerId], references: [id])
  farmerCreditAmount    Float?   @map("farmer_credit_amount")
  
  // Commission breakdown (when referrer exists)
  agentId               String?  @map("agent_id")
  agentCommissionAmount Float?   @map("agent_commission_amount")
  scrapnetAmount        Float?   @map("scrapnet_amount")
  
  // Hedera Guardian metadata
  hederaGuardianJson    String   @map("hedera_guardian_json") @db.Text
  guardianTimestamp     DateTime @map("guardian_timestamp")
  
  // Certificate metadata for blockchain attestation
  certificateJson       String?  @map("certificate_json") @db.Text
  
  // Dual-Blockchain Attestation
  // Hedera HCS - Consensus Service for immutable audit trail
  hederaTopicId         String?  @map("hedera_topic_id")
  hederaTransactionId   String?  @map("hedera_transaction_id")
  hederaConsensusTimestamp String? @map("hedera_consensus_timestamp")
  hederaMessageHash     String?  @map("hedera_message_hash")
  
  // Polygon ERC-1155 - Fractionalized CDR token
  polygonTokenId        String?  @map("polygon_token_id")
  polygonTransactionHash String? @map("polygon_transaction_hash")
  polygonContractAddress String? @map("polygon_contract_address")
  polygonMintTimestamp  DateTime? @map("polygon_mint_timestamp")
  polygonTokenUri       String?  @map("polygon_token_uri") @db.Text
  
  // Cross-chain linkage metadata
  crossChainMetadataJson String? @map("cross_chain_metadata_json") @db.Text

  @@index([batchId])
  @@index([farmerId])
  @@index([createdAt])
  @@map("biochar_batches")
}

// Recycling Log for Asphalt Engine
model RecyclingLog {
  id                    String   @id @default(uuid())
  logId                 String   @unique @map("log_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  // Verification status (for agent approval)
  verificationStatus    VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt            DateTime? @map("verified_at")
  verifiedBy            String?   @map("verified_by")
  rejectionReason       String?   @map("rejection_reason")
  
  // Recycling details
  materialType          String   @map("material_type")  // RAP, millings, reclaimed aggregate
  weightKg              Float    @map("weight_kg")
  sourceLocation        String?  @map("source_location")
  sourceGps             String?  @map("source_gps")
  
  // Processing info
  processingDate        DateTime @map("processing_date")
  destinationLocationId String?  @map("destination_location_id")
  destinationLocation   Location? @relation(fields: [destinationLocationId], references: [id])
  
  // Submitter info
  submittedById         String?  @map("submitted_by_id")
  submittedBy           User?    @relation(fields: [submittedById], references: [id])
  
  // Notes
  notes                 String?  @db.Text

  @@index([logId])
  @@index([verificationStatus])
  @@index([createdAt])
  @@map("recycling_logs")
}

model FarmerCredit {
  id              String   @id @default(uuid())
  creditId        String   @unique @map("credit_id")
  createdAt       DateTime @default(now()) @map("created_at")
  
  // Credit details
  creditAmount    Float    @map("credit_amount")
  creditType      String   @map("credit_type")  // "biochar_contribution", "feedstock_supply"
  status          String   @default("pending")  // "pending", "issued", "redeemed"
  
  // Related batch
  batchId         String?  @map("batch_id")
  
  // Farmer relation
  farmerId        String   @map("farmer_id")
  farmer          Farmer   @relation(fields: [farmerId], references: [id])
  
  // Issuance details
  issuedAt        DateTime? @map("issued_at")
  redeemedAt      DateTime? @map("redeemed_at")
  
  // Blockchain reference
  tokenId         String?  @map("token_id")
  transactionHash String?  @map("transaction_hash")

  @@map("farmer_credits")
}

// ==================== CONSENT & COMPLIANCE ====================

model UserConsent {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  // User identification
  email                 String?
  walletAddress         String?  @map("wallet_address")
  
  // Consent flags
  termsAccepted         Boolean  @default(false) @map("terms_accepted")
  carbonRightsTransfer  Boolean  @default(false) @map("carbon_rights_transfer")
  aiMonitoring          Boolean  @default(false) @map("ai_monitoring")
  
  // Consent timestamps
  termsAcceptedAt       DateTime? @map("terms_accepted_at")
  carbonRightsAt        DateTime? @map("carbon_rights_at")
  aiMonitoringAt        DateTime? @map("ai_monitoring_at")
  
  // Audit trail
  consentHash           String   @unique @map("consent_hash")
  ipAddress             String?  @map("ip_address")
  userAgent             String?  @map("user_agent") @db.Text
  
  // Version tracking
  termsVersion          String   @default("1.0") @map("terms_version")
  
  // Consent history
  consentLogs           ConsentLog[]

  @@map("user_consents")
}

model ConsentLog {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now()) @map("created_at")
  
  // User reference
  userId          String   @map("user_id")
  userConsent     UserConsent @relation(fields: [userId], references: [userId])
  
  // Log details
  action          String   // "accept", "revoke", "update"
  consentType     String   @map("consent_type")  // "terms", "carbon_rights", "ai_monitoring"
  previousValue   Boolean  @map("previous_value")
  newValue        Boolean  @map("new_value")
  
  // Audit hash for this specific action
  logHash         String   @unique @map("log_hash")
  
  // Context
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent") @db.Text

  @@map("consent_logs")
}

// ==================== METAL RECOVERY ENGINE ====================

enum MetalType {
  STEEL
  ALUMINUM
  COPPER
  BRASS
  STAINLESS
  MIXED
  OTHER
}

model MetalRecoveryLog {
  id                    String   @id @default(uuid())
  logId                 String   @unique @map("log_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  // Verification status
  verificationStatus    VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt            DateTime? @map("verified_at")
  verifiedBy            String?   @map("verified_by")
  rejectionReason       String?   @map("rejection_reason")
  
  // Metal details
  metalType             MetalType @map("metal_type")
  weightKg              Float     @map("weight_kg")
  purityPercent         Float     @default(90) @map("purity_percent")
  
  // Source traceability
  sourceDescription     String?   @map("source_description")
  sourceLocationId      String?   @map("source_location_id")
  sourceGps             String?   @map("source_gps")
  
  // Processing info
  processingDate        DateTime  @map("processing_date")
  destinationLocationId String?   @map("destination_location_id")
  
  // Carbon savings calculation
  // Avoided emissions = weight × emission factor × purity
  avoidedEmissionsKg    Float     @map("avoided_emissions_kg")
  emissionFactorUsed    Float     @map("emission_factor_used")
  
  // Submitter info
  submittedById         String?   @map("submitted_by_id")
  
  // Notes
  notes                 String?   @db.Text
  
  // Blockchain attestation
  blockchainJson        String?   @map("blockchain_json") @db.Text

  @@index([logId])
  @@index([metalType])
  @@index([verificationStatus])
  @@index([createdAt])
  @@map("metal_recovery_logs")
}

// ==================== DIGITAL VAULT NODE MODELS ====================

enum VaultNodeType {
  BANK              // Financial institution
  VAULT             // Secure storage facility
  CERTIFIED_PROCESSOR // Licensed destruction facility
}

enum CurrencyType {
  USD               // US Dollar
  EUR               // Euro
  GBP               // British Pound
  JPY               // Japanese Yen
  CHF               // Swiss Franc
  GOLD_BULLION      // Gold bars/coins
  SILVER_BULLION    // Silver bars/coins
  PLATINUM          // Platinum
  MIXED_PRECIOUS    // Mixed precious metals
}

enum VaultVerificationStatus {
  DRAFT             // In progress
  PENDING_AI_CHECK  // Waiting for AI verification
  AI_VERIFIED       // AI check passed
  AI_FLAGGED        // AI detected issues
  PENDING_DESTRUCTION // Awaiting destruction proof
  DESTRUCTION_UPLOADED // Video uploaded, pending review
  COMPLETED         // Fully verified and processed
  REJECTED          // Failed verification
}

model VaultNode {
  id                String        @id @default(uuid())
  nodeId            String        @unique @map("node_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  
  // Node identification
  name              String
  nodeType          VaultNodeType @map("node_type")
  
  // Certification details
  certificationNumber String?     @map("certification_number")
  certifiedUntil    DateTime?     @map("certified_until")
  isActive          Boolean       @default(true) @map("is_active")
  
  // Contact & location
  address           String?
  region            String?       // e.g., "North America", "Europe", "Asia Pacific"
  country           String?
  coordinates       String?       // "lat,lng" for map display
  contactName       String?       @map("contact_name")
  contactEmail      String?       @map("contact_email")
  contactPhone      String?       @map("contact_phone")
  
  // Security clearance level (1-5)
  securityLevel     Int           @default(3) @map("security_level")
  
  // Associated users
  operators         VaultNodeOperator[]
  
  // Verifications processed by this node
  verifications     VaultVerification[]

  @@index([nodeType])
  @@index([isActive])
  @@map("vault_nodes")
}

model VaultNodeOperator {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now()) @map("created_at")
  
  // Link to user
  userId          String    @map("user_id")
  
  // Link to vault node
  vaultNodeId     String    @map("vault_node_id")
  vaultNode       VaultNode @relation(fields: [vaultNodeId], references: [id])
  
  // Role within the vault
