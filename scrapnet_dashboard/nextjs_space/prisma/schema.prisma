  marketRateMultiplier  Float             @default(1.0) @map("market_rate_multiplier")
  legacyYieldUsd        Float             @map("legacy_yield_usd")
  
  // Dynamic BPS Split
  founderYieldUsd       Float             @map("founder_yield_usd")
  stewardshipUsd        Float             @map("stewardship_usd")
  publicResilienceUsd   Float             @map("public_resilience_usd")
  
