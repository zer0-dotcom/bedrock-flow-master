// ==================== BUSINESS SUBMISSION PORTAL ====================

enum SubmissionTrack {
  TRACK_A_MATERIALS     // Asphalt/Concrete/Metal invoices → ICE v4.1
  TRACK_B_ENERGY_179D   // Building envelopes & energy audits → IRS 7205
  TRACK_C_BIOCHAR_CDR   // Biochar production receipts → CDR credits
}

enum SubmissionStatus {
  DRAFT                       // Initial upload, not yet parsed
  PENDING_FORENSIC_VERIFICATION // Parsed, awaiting HUM event match
  FORENSIC_VERIFIED           // Matched a notarized HUM event
  SETTLEMENT_COMPLETE         // Dynamic BPS split executed
  REJECTED_FORENSIC           // Failed forensic verification
  // v2.4 — Sentinel Verdict tiers
  AUTO_APPROVED
  PENDING_SOVEREIGN_REVIEW
  PENDING_AUTHORIZATION
  SOVEREIGN_HOLD
  ESCROW_REVIEW
  PENDING_PLATFORM_REVIEW
  REJECTED
}

// Precious Metals assay certification status
enum AssayStatus {
  UNASSAYED
  PENDING
  CERTIFIED
}

// Settlement asset class variant routing (A–E)
enum SettlementAssetClass {
  SOVEREIGN_SKIN            // Variant A: Sovereign Skin™ / Gripsy
  PROPERTY_INDUSTRIAL       // Variant B: Property — Industrial
  PROPERTY_RESIDENTIAL      // Variant C: Property — Residential
  PHYSICAL_COMMODITIES      // Variant D: Physical Commodities
  PRECIOUS_METALS_CUSTODIAL // Variant E: Precious Metals Custodial
}

model Submission {
  id                    String              @id @default(uuid())
  submissionId          String              @unique @map("submission_id")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  // Track classification
  track                 SubmissionTrack
  status                SubmissionStatus    @default(DRAFT)

  // Corporate identity (wallet-gated)
  walletAddress         String              @map("wallet_address")
  companyName           String?             @map("company_name")
  submittedById         String?             @map("submitted_by_id")

  // Service Identity tether
  serviceIdentity       String              @default("9tsq8qB4P9uPRSHrjXLaDQJd93nuo4wEEtkR1tAJRAQ3") @map("service_identity")

  // AI-parsed forensic data (populated by LLM parser)
  vendorName            String?             @map("vendor_name")
  energyDeltaMw         Float?              @map("energy_delta_mw")
  materialVolume        Float?              @map("material_volume")
  materialUnit          String?             @map("material_unit")    // tonnes, kg, m³, etc.
  materialSku           String?             @map("material_sku")
  extractedTimestamp    DateTime?           @map("extracted_timestamp")
  parserConfidence      Float?              @map("parser_confidence") // 0-1

  // ICE v4.1 mapping (Track A)
  iceCoefficient        Float?              @map("ice_coefficient")
  iceMaterial           String?             @map("ice_material")

  // 179D compliance (Track B)
  irsForm7205Json       String?             @map("irs_form_7205_json") @db.Text
  buildingEnvelopeJson  String?             @map("building_envelope_json") @db.Text

  // CDR linkage (Track C)
  biocharBatchRef       String?             @map("biochar_batch_ref")
  cdrCreditsTonnes      Float?              @map("cdr_credits_tonnes")

  // Carbon impact (calculated)
  carbonTonnes          Float?              @map("carbon_tonnes")
  carbonValueUsd        Float?              @map("carbon_value_usd")

  // Forensic verification
  humEventHash          String?             @map("hum_event_hash")   // Matching HUM tx
  forensicVerifiedAt    DateTime?           @map("forensic_verified_at")
  backtraceId           String              @default("BT-C9C4C5") @map("backtrace_id")

  // Notary anchor
  solanaTxHash          String?             @map("solana_tx_hash")
  notaryAnchoredAt      DateTime?           @map("notary_anchored_at")

  // Founder approval gate (Human-in-the-loop circuit breaker)
  founderApproved       Boolean             @default(false) @map("founder_approved")
  founderApprovedAt     DateTime?           @map("founder_approved_at")
  founderApprovalNote   String?             @map("founder_approval_note") @db.Text

  // Protocol ingest metadata
  ingestProtocol        String?             @map("ingest_protocol")    // "aethexer-v1" or null for legacy
  ingestTimestamp       DateTime?           @map("ingest_timestamp")

  parserResultJson      String?             @map("parser_result_json") @db.Text

  // Documents
  documents             SubmissionDocument[]

  // Settlement
  settlement            Settlement?

  // Precious Metals ingest payload (Track A — Precious Metals)
  purityPercentage      Float?              @map("purity_percentage")   // 0.0–1.0 (e.g. 0.999 for 99.9%)
  assayStatus           AssayStatus?        @map("assay_status")        // UNASSAYED | PENDING | CERTIFIED
  refineryDiscount      Float?              @map("refinery_discount")   // USD discount applied by refinery
  spotPriceAtIngest     Float?              @map("spot_price_at_ingest") // Spot price at time of ingest (USD/oz)
  verifiedAssetValue    Float?              @map("verified_asset_value") // VAL = (Spot × Weight × Purity) − Refinery Discount

  // Certificate
  certificateUrl        String?             @map("certificate_url")
  certificateHash       String?             @map("certificate_hash")

  @@index([track])
  @@index([status])
  @@index([walletAddress])
  @@index([createdAt])
  @@map("submissions")
}

model SubmissionDocument {
  id                    String              @id @default(uuid())
  createdAt             DateTime            @default(now()) @map("created_at")

  // Parent submission
  submissionId          String              @map("submission_id")
  submission            Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // File metadata
  fileName              String              @map("file_name")
  fileType              String              @map("file_type")    // pdf, csv, xlsx, docx, ply, splat
  fileSizeBytes         Int                 @map("file_size_bytes")
  cloudStoragePath      String              @map("cloud_storage_path")
  fileHash              String              @map("file_hash")    // SHA-256

  // Parsing status
  parsed                Boolean             @default(false)
  parsedAt              DateTime?           @map("parsed_at")
  parseResultJson       String?             @map("parse_result_json") @db.Text

  @@index([submissionId])
  @@map("submission_documents")
}

model Settlement {
  id                    String              @id @default(uuid())
  settlementId          String              @unique @map("settlement_id")
  createdAt             DateTime            @default(now()) @map("created_at")

  // Parent submission
  submissionId          String              @unique @map("submission_id")
  submission            Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Total value being settled
  totalValueUsd         Float               @map("total_value_usd")

  // Dynamic BPS split — Verified Asset Value / Verification Node / Public Resilience
  assetOwnerShare       Float               @map("asset_owner_share")       // 70% Verified Asset Value
  assetOwnerWallet      String              @map("asset_owner_wallet")
  treasuryShare         Float               @map("treasury_share")          // 20% Verification Node
  treasuryWallet        String              @default("BEDROCK_ESG_TREASURY") @map("treasury_wallet")
  specialistShare       Float               @map("specialist_share")        // 10% Public Resilience
  specialistId          String?             @map("specialist_id")
  specialistWallet      String?             @map("specialist_wallet")

  // Public Resilience fallback (singular block — no hardcoded sub-splits)
  routedToSustainabilityPool Boolean        @default(false) @map("routed_to_sustainability_pool")
  sustainabilityPoolVault    String?        @map("sustainability_pool_vault")

  // Asset class variant routing (A–E)
  assetClass                 SettlementAssetClass? @map("asset_class")
  assetClassMetadata         String?               @map("asset_class_metadata") @db.Text  // Dynamic routing metadata JSON

  // Execution proof
  executed              Boolean             @default(false)
  executedAt            DateTime?           @map("executed_at")
  executionHash         String?             @map("execution_hash")

  // Solana anchor proof (Settlement→Notary bridge)
  solanaSignature       String?             @map("solana_signature")
  solanaAnchoredAt      DateTime?           @map("solana_anchored_at")
  anchorPending         Boolean             @default(false) @map("anchor_pending")

  @@index([createdAt])
  @@map("settlements")
}

// ==================== USER PROFILES (UNIFIED VIEW) ====================
