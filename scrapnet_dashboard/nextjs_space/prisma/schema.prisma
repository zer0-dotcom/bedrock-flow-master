  adminFrictionAvoided  Float             @map("admin_friction_avoided")    // USD value
  logisticsFrictionAvoided Float          @map("logistics_friction_avoided") // USD value
  totalFrictionAvoided  Float             @map("total_friction_avoided")     // USD value
  
