// ==================== v2.4 AUDIT LOG ====================

model AuditLog {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now()) @map("created_at")

  // Actor
  actorId         String    @map("actor_id")
  actorRole       UserRole  @map("actor_role")

  // Event classification
  eventType       String    @map("event_type")   // SUBMISSION_STATUS_CHANGE, SETTLEMENT_EXECUTED, BLOCKCHAIN_ANCHOR, ROLE_CHANGE, VERDICT_OVERRIDE
  entityType      String    @map("entity_type")  // Submission, Settlement, User, TelemetryReading
  entityId        String    @map("entity_id")

  // Change payload
  previousValue   String?   @map("previous_value") @db.Text
  newValue        String?   @map("new_value") @db.Text
  metadata        String?   @db.Text               // JSON: contextual metadata

  // Audit hash for tamper detection
  auditHash       String?   @map("audit_hash")

  // Backtrace
  backtraceId     String    @default("BT-C9C4C5") @map("backtrace_id")

  @@index([actorId])
  @@index([eventType])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model TelemetryReading {
  id                  String               @id @default(uuid())
  nodeId              String               @map("node_id")
  powerUsageKw        Float                @map("power_usage_kw")
  pueRatio            Float                @map("pue_ratio")
  carbonPerTradeG     Float                @map("carbon_per_trade_g")
  gridIntensityScore  Float                @map("grid_intensity_score")
  assetClass          SettlementAssetClass @default(PROPERTY_INDUSTRIAL) @map("asset_class")
  assetClassMetadata  String?              @map("asset_class_metadata") @db.Text  // Dynamic routing metadata JSON per variant

  // Sentinel verification
  sentinelVerdict     String?              @map("sentinel_verdict")   // AUTO_APPROVED | PENDING_SOVEREIGN_REVIEW | SOVEREIGN_HOLD | PENDING_AUTHORIZATION | ESCROW_REVIEW | PENDING_PLATFORM_REVIEW | REJECTED
  sentinelScore       Float?               @map("sentinel_score")     // Composite score 0-1
  sentinelHash        String?              @map("sentinel_hash")      // SHA-256 audit hash

  // Settlement (auto-triggered on AUTO_APPROVED)
  settlementId        String?              @map("settlement_id")
  settled             Boolean              @default(false)
  settledAt           DateTime?            @map("settled_at")

  // Auth metadata
  authMethod          String?              @map("auth_method")        // protocol_key | field_key
  sourceIp            String?              @map("source_ip")

  createdAt           DateTime             @default(now()) @map("created_at")

  @@index([nodeId])
  @@index([nodeId, createdAt])
  @@index([settled])
  @@map("telemetry_readings")
}